                        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-2">
                            <p class="text-xs sm:text-sm font-medium text-slate-800"><strong class="text-blue-600 mr-1">${index+1}.</strong> ${item.prompt}</p>
                            <input type="text" ${disabled} value="${val}" oninput="userAnswers.completes[${index}] = this.value" placeholder="Escriba su respuesta aquí..." class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs sm:text-sm font-medium text-slate-800 focus:ring-2 focus:ring-blue-600 outline-none">
                        </div>
                    `;
                });

                html += `</div></div>`;
            } else if (currentSection === 'development') {
                const dev = levelConfig.development;
                const disabled = isSubmitted ? 'disabled' : '';
                html += `
                    <div class="space-y-6">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-4 border-b border-slate-200 gap-4">
                            <div>
                                <h3 class="text-xl font-extrabold text-slate-900">IV Parte: Desarrollo Teórico</h3>
                                <p class="text-xs text-slate-500">Valor: 4-5 puntos totales. Analice el texto y responda cada interrogante.</p>
                            </div>
                            ${isSubmitted ? '<span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full">Apartado Enviado y Bloqueado</span>' : '<button onclick="submitSection(\'development\')" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow transition">Enviar y Bloquear Apartado</button>'}
                        </div>

                        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 space-y-4">
                            <h4 class="font-extrabold text-blue-900 text-sm uppercase tracking-wider">Texto de Análisis Teórico</h4>
                            <p class="text-xs sm:text-sm text-blue-950 whitespace-pre-line leading-relaxed font-medium">${dev.text}</p>
                            ${dev.image ? `<div class="mt-4 overflow-hidden rounded-2xl border border-blue-200 max-w-lg mx-auto bg-white p-2 shadow-sm"><img src="${dev.image}" alt="Imagen ilustrativa" class="w-full h-auto rounded-xl object-cover max-h-64"></div>` : ''}
                        </div>

                        <div class="space-y-6 pt-2">
                `;

                dev.questions.forEach((qItem, qIdx) => {
                    const val = userAnswers.development[qIdx] || "";
                    html += `
                        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-3">
                            <div class="flex justify-between items-start gap-4">
                                <p class="text-xs sm:text-sm font-bold text-slate-900">${qItem.q}</p>
                                <span class="bg-blue-100 text-blue-800 text-xs font-extrabold px-2.5 py-1 rounded-lg flex-shrink-0">${qItem.value} pts</span>
                            </div>
                            <textarea ${disabled} rows="3" oninput="userAnswers.development[${qIdx}] = this.value" placeholder="Escriba su respuesta argumentada aquí..." class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs sm:text-sm font-medium text-slate-800 focus:ring-2 focus:ring-blue-600 outline-none">${val}</textarea>
                        </div>
                    `;
                });

                html += `</div></div>`;
            } else if (currentSection === 'bonus') {
                const bonus = levelConfig.bonus;
                const val = userAnswers.bonus || "";
                const disabled = isSubmitted ? 'disabled' : '';
                html += `
                    <div class="space-y-6">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-4 border-b border-slate-200 gap-4">
                            <div>
                                <h3 class="text-xl font-extrabold text-slate-900">Pregunta Opcional / Bonificación</h3>
                                <p class="text-xs text-slate-500">Valor: +1 punto extra (Opcional). No afecta negativamente su nota si se omite.</p>
                            </div>
                            ${isSubmitted ? '<span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-xs font-bold rounded-full">Apartado Enviado y Bloqueado</span>' : '<button onclick="submitSection(\'bonus\')" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow transition">Enviar y Bloquear Apartado</button>'}
                        </div>

                        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 space-y-4">
                            <div class="flex items-center space-x-2 text-amber-800">
                                <i class="fa-solid fa-star"></i>
                                <span class="text-xs font-extrabold uppercase tracking-wider">Pregunta Extra de Bonificación (+1 pt)</span>
                            </div>
                            <p class="text-xs sm:text-sm font-bold text-amber-950">${bonus.q}</p>
                            <textarea ${disabled} rows="4" oninput="userAnswers.bonus = this.value" placeholder="Redacte su respuesta complementaria..." class="w-full bg-white border border-amber-300 rounded-xl p-3 text-xs sm:text-sm font-medium text-slate-800 focus:ring-2 focus:ring-amber-500 outline-none">${val}</textarea>
                        </div>

                        <!-- Final Exam Submit Button -->
                        <div class="pt-6 border-t border-slate-200 flex justify-center">
                            <button onclick="submitEntireExam()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm sm:text-base py-4 px-10 rounded-2xl shadow-xl shadow-emerald-600/30 transition flex items-center space-x-3">
                                <i class="fa-solid fa-paper-plane"></i>
                                <span>Finalizar y Entregar Examen Completo</span>
                            </button>
                        </div>
                    </div>
                `;
            }

            container.innerHTML = html;
        }

        function submitSection(section) {
            sectionSubmitted[section] = true;
            renderCurrentSection();
            alert("¡Apartado enviado y bloqueado correctamente!");
        }

        function submitEntireExam() {
            if (!confirm("¿Está seguro de que desea finalizar y entregar el examen completo? No podrá realizar modificaciones posteriores.")) {
                return;
            }

            Object.keys(sectionSubmitted).forEach(k => sectionSubmitted[k] = true);
            examActive = false;
            registeredSubmissions[currentStudent.email] = true;

            document.getElementById('view-exam').classList.add('hidden');
            document.getElementById('view-submitted').classList.remove('hidden');

            document.getElementById('conf-name').innerText = currentStudent.name;
            document.getElementById('conf-email').innerText = currentStudent.email;
            document.getElementById('conf-level').innerText = currentStudent.level === 10 ? "10° Química" : `${currentStudent.level}° Año`;
            document.getElementById('submitted-msg-student').innerText = `Estimado(a) ${currentStudent.name}, sus respuestas han sido registradas correctamente en los servidores de Saint Peter's School.`;
        }

        function promptSecretCode(isLockedOut = false) {
            const modal = document.getElementById('modal-secret');
            modal.classList.remove('hidden');
            document.getElementById('secret-pass').value = "";
            document.getElementById('secret-error').classList.add('hidden');

            if (isLockedOut) {
                document.getElementById('secret-modal-title').innerText = "¡Pantalla Bloqueada por Infracciones!";
                document.getElementById('secret-modal-desc').innerText = "Ha superado el límite de 3 advertencias por intentos de fraude. La pantalla permanecerá bloqueada hasta que el docente ingrese el código secreto (5531).";
                document.getElementById('btn-cancel-secret').classList.add('hidden');
            } else {
                document.getElementById('secret-modal-title').innerText = "Código de Acceso Docente";
                document.getElementById('secret-modal-desc').innerText = "Ingrese el código secreto de 4 dígitos proporcionado por el profesor.";
                document.getElementById('btn-cancel-secret').classList.remove('hidden');
            }
        }

        function closeSecretModal() {
            if (fraudCount >= 3) return;
            document.getElementById('modal-secret').classList.add('hidden');
        }

        function verifySecretCode() {
            const code = document.getElementById('secret-pass').value.trim();
            if (code === "5531") {
                delete registeredSubmissions[currentStudent.email];
                fraudCount = 0;
                closeSecretModal();
                alert("¡Código verificado correctamente! Se ha desbloqueado la sesión.");
                document.getElementById('view-submitted').classList.add('hidden');
                document.getElementById('view-welcome').classList.remove('hidden');
                document.getElementById('input-student-email').disabled = false;
                document.getElementById('input-student-name').disabled = false;
                document.getElementById('input-student-email').value = "";
                document.getElementById('input-student-name').value = "";
            } else {
                document.getElementById('secret-error').classList.remove('hidden');
            }
        }
    </script>
</body>
</html>